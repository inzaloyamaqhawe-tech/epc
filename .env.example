# [DEPLOYMENT:REQUIRED] Node >=24.7, reverse proxy with HTTPS in production
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
# [SECRET:SERVER_ONLY] generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=
# [DEV_ONLY] loopback demo is isolated, synthetic and cannot activate certificates
DEMO_MODE=false
DATA_DIR=./data
STORAGE_DRIVER=local
# [DEPLOYMENT:REQUIRED] for S3, use an IAM role or AWS credential provider chain
S3_BUCKET=
AWS_REGION=af-south-1
# [DEPLOYMENT:REQUIRED] template reviewed by issuing professional; false until independently approved
ISSUANCE_ENABLED=false
# [SECRET:SERVER_ONLY] SMTP password (optional email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# [PRIVACY:REVIEW] responsible party contact; required to open production service
PRIVACY_CONTACT=
